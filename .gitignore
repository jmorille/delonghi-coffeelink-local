node_modules/
.next/
out/
.env.local
.env*.local
# Etat runtime : recettes locales et cache des lectures machine (noms de profils,
# checksums, Bean System). Regenere par la machine, et contient des donnees perso.
data/
next-env.d.ts
*.tsbuildinfo

# Artefacts de travail du skill Impeccable (instantanes de critique, session du serveur
# de previsualisation avec son jeton). Local, jamais publie.
.impeccable/

# ⚠️ `public/boissons/` et `public/grains/` sont désormais VERSIONNÉS, sur décision explicite du
# propriétaire du dépôt (2026-09-01). Ce sont des visuels De'Longhi — extraits de l'APK pour les
# boissons, tirés du seau S3 du questionnaire pour les grains — et le dépôt est public : ils sont
# donc redistribués. Les tables de correspondance (src/lib/beverage-images.json,
# src/lib/bean-images.json) et les scripts qui les régénèrent restent en place ; ils ne sont plus
# la seule façon d'obtenir les fichiers.


# Conversions SVG de ces mêmes visuels (scripts de test). Une œuvre dérivée reste l'œuvre : les
# vectoriser ne les rend pas redistribuables. Elles suivent donc public/boissons/ ci-dessus.
public/boissons-svg/

# Idem pour toute autre déclinaison : les cinq densités de l'APK (boissons-mdpi … boissons-xxxhdpi),
# ou n'importe quel répertoire de comparaison. Un motif plutôt qu'une ligne par densité — la règle
# porte sur la NATURE du contenu, pas sur la liste des variantes qu'on aura extraites ce jour-là,
# et une variante ajoutée sans sa ligne serait publiée sans que rien ne le signale.
public/boissons-*/

# La page de comparaison SVG/WebP. Elle ne compare que des repertoires eux-memes ignores et ne
# peut rien montrer sans eux : committee, elle afficherait 58 cadres vides a tout le monde sauf a
# qui a lance l'extraction. C'est un artefact de mesure, il suit ce qu'il mesure.
public/comparaison-svg.html

# Outillage d'assistants local, jamais du produit : serveurs MCP declares pour cette machine
# (.mcp.json), configuration opencode, et le crochet du skill Impeccable. Ils decrivent le poste de
# travail de qui developpe, pas le serveur qu'on livre — les versionner imposerait a tout clone une
# liste de serveurs et de crochets qu'il n'a pas demandee. Les fichiers restent en place localement.
.mcp.json
opencode.json
.github/hooks/
